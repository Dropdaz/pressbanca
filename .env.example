# Riot API key (https://developer.riotgames.com). Leave empty to run with demo data.
RIOT_API_KEY=
# Optional: rate limits of your key, "requests:seconds" pairs (dev key default).
# RIOT_RATE_LIMITS=20:1,100:120
# Optional: how many ranked games to analyse, and how many lobbies/players to read ranks for.
# LOL_MATCH_COUNT=20
# LOL_LOBBY_MATCHES=10
# LOL_LOBBY_PLAYERS=5

# Storage: Supabase project (schema in supabase/migrations). Without these, data goes to .data/ files.
SUPABASE_URL=
# Secret (server-only) key, sb_secret_... — never expose it to the browser.
SUPABASE_SECRET_KEY=
# Protects /api/cron (Vercel Cron sends it as a Bearer token; external crons can use ?secret=).
CRON_SECRET=
